generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int           @id @default(autoincrement())
  email              String        @unique
  name               String?
  googleId           String        @unique
  accessToken        String?
  refreshToken       String?
  tokenExpiry        DateTime?
  isAdmin            Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]
}

model Appointment {
  id          Int      @id @default(autoincrement())
  hostId      Int
  host        User     @relation(fields: [hostId], references: [id])
  clientEmail String
  clientName  String?
  location    String?
  service     String?
  startTime   DateTime
  endTime     DateTime

  @@index([hostId])
}

model SystemSettings {
  id                 Int      @id @default(1)
  adminId            Int?     @unique
  isCalendarConnected Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
