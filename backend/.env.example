# =============================================================================
# BANCO DE DADOS (SQLite - arquivo local)
# =============================================================================
# Caminho relativo parte da pasta backend/. Em produção (Hostinger) use um caminho
# absoluto FORA da pasta do app, para o deploy não apagar os dados:
# DATABASE_URL="file:/home/u528425499/data/agendamento.db"
DATABASE_URL="file:./agendamento.db"

# =============================================================================
# GOOGLE OAUTH (Google Cloud Console)
# =============================================================================
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET
# IMPORTANTE: Atualize com seu domínio real (temporário ou final da Hostinger)
GOOGLE_REDIRECT_URI=https://SEU_DOMINIO/api/auth/google/callback

# =============================================================================
# SEGURANÇA (Troque antes de colocar em produção!)
# =============================================================================
ADMIN_PASSWORD=admin123
ENCRYPTION_KEY=skla_secure_key_32_chars_12345678
JWT_SECRET=skla_jwt_secret_token_87654321

# =============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================================
NODE_ENV=production
# Deixe em branco — a Hostinger define a PORT automaticamente via process.env.PORT
# PORT=3000

# =============================================================================
# ALERTAS POR E-MAIL (Resend - https://resend.com)
# =============================================================================
# Avisa quando o Google desconecta a agenda principal ou a do funcionário.
RESEND_API_KEY=re_SUA_CHAVE
# Destinatários separados por vírgula. Sem domínio verificado no Resend,
# só é possível enviar para o e-mail dono da conta do Resend.
ALERT_EMAIL_TO=seu@email.com
# Opcional, exige domínio verificado no Resend:
# ALERT_EMAIL_FROM="Agendamento SKLA <alertas@skla.video>"
